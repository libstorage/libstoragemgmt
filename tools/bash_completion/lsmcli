            ;;
        *)
        ;;
    esac

    # Handle the case where we are starting out with nothing
    if [[ ${_lsm_prev} == 'lsmcli' ]] ; then
        if [[ ${_lsm_cur} == --* ]] ; then
            COMPREPLY=( $(compgen -W "${_lsm_opts_long}"  -- "${_lsm_cur}") )
