# Bash completion for lsmcli.
#
# The completion itself is done by lsmcli, in the hidden 'lsmcli __complete',
# so the commands, aliases, options and choices it offers are those lsmcli
# parses with. What is here only hands the line to it, and the candidates it
# prints, one to a line, escaped for a word with no quote open, back to
# bash. It uses nothing but builtins of bash, and none of the helpers of the
# bash-completion package. If lsmcli, or the Python bindings it needs, are not
# there, there is no completion.
#
# Value look-ups ('lsmcli list' for systems, pools, volumes, ...) can be slow
# or hang depending on plugin and configuration, so they are off unless
# LSMCLI_AUTO_COMPLETE_VALUE=1 is set in the shell. It is read on every
# completion, so it can be set or changed after this file is sourced.
#
# Completion only fills things in, and the typed line is never used to choose
# a target or a filter. A look-up is for what lsmcli is set up with: LSMCLI_URI,
# which has to be exported, and ~/.lsmcli, whatever the line says, so --vol
# offers every volume of that array, and there is none at all if the line has a
# -u or --uri in it, or the word being completed a quote or a $; see lsm/lsmcli/
# completion.py. A variable given to the command alone, as in
# 'LSMCLI_URI=other lsmcli vd --vol <TAB>', is not seen, bash 5.3 takes it off
# COMP_LINE, so the look-up is for the array of the shell, not for 'other'. A
# wrapper such as 'sudo lsmcli' or 'nice lsmcli' gets here through
# bash-completion's _command_offset, and the look-up is then run as the current
# user with the current environment, not as the wrapped command would be. If
# lsmcli is an alias or a function there is no look-up, as what it adds to the
# line is not known.
#
# Nothing is evaluated: the line is a single argument of the program, and what
# comes back is data. The only name this file defines is _lsm.
#
# Needs bash 4.0 or later, for mapfile.

# The program that is run is the first one in PATH. Only when look-ups are on,
# and so the user has asked for lsmcli to be run for what is typed, is a
# program that was typed with a path, eg. ./lsmcli, run in its place, and
# only if it is an executable file. A TAB never runs what is merely typed
# otherwise, as the line could be anything.
function _lsm()
{
    local _lsm_prog=${COMP_LINE#"${COMP_LINE%%[![:blank:]]*}"}
    local _lsm_run _lsm_out=''
    local -a _lsm_extra=()

    COMPREPLY=()
    _lsm_prog=${_lsm_prog%%[[:blank:]]*}
    [[ -n ${_lsm_prog} ]] || return 0
    _lsm_run=lsmcli
    if [[ ${_lsm_prog} != */* ]] ; then
        _lsm_run=${_lsm_prog}
    elif [[ ${LSMCLI_AUTO_COMPLETE_VALUE-} == 1 && -f ${_lsm_prog} && \
            -x ${_lsm_prog} ]] ; then
        _lsm_run=${_lsm_prog}
    else
        # The one in PATH completes what does not need the program that was
        # typed, and nothing is looked up for the one that was.
        _lsm_extra=(--no-lookup)
    fi
    # An alias or a function of that name is not run: command skips them. It
    # is not known what they add to the line, eg. a -u of its own, and so which
    # array the line is for.
    if alias -- "${_lsm_prog}" &> /dev/null || \
            declare -F -- "${_lsm_prog}" &> /dev/null ; then
        _lsm_extra=(--no-lookup)
    fi

    # $(...) rather than a process substitution, which would not be stopped by
    # Ctrl-C and be left running. Errors from lsmcli go nowhere as they would be
    # written over the user's command line. The setting is passed on as it is
    # in the shell, exported or not.
    _lsm_out=$(LSMCLI_AUTO_COMPLETE_VALUE=${LSMCLI_AUTO_COMPLETE_VALUE-} \
        command -- "${_lsm_run}" __complete --point "${COMP_POINT}" \
        --breaks "${COMP_WORDBREAKS}" ${_lsm_extra[@]+"${_lsm_extra[@]}"} \
        -- "${COMP_LINE}" < /dev/null 2> /dev/null) || :
    if [[ -n ${_lsm_out} ]] ; then
        mapfile -t COMPREPLY <<< "${_lsm_out}"
    fi
    return 0
}
complete -F _lsm lsmcli
